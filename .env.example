# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum

# MySQL Relational Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=AttendanceManagement
MYSQL_USER=faculty_user
MYSQL_PASSWORD=ReplaceWithAStrongPassword!

# MongoDB NoSQL Database Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=AttendanceManagement

# Application Security
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False  # Set to True in production HTTPS
